from collections.abc import Sequence
from typing import Any, Self

__version__: str

class NotFound(FileNotFoundError): ...
class Corruption(Exception): ...
class NotSupported(Exception): ...
class InvalidArgument(Exception): ...
class StoreIOError(OSError): ...
class Conflict(Exception): ...
class MergeInProgress(Exception): ...
class Incomplete(Exception): ...

class _Iter:
    def seek_to_first(self) -> None: ...
    def seek_to_last(self) -> None: ...
    def seek(self, key: bytes) -> None: ...
    def seek_for_prev(self, key: bytes) -> None: ...
    def skip(self) -> None: ...

class KeysIterator(_Iter):
    def get(self) -> bytes: ...
    def next(self) -> bytes | None: ...
    def __iter__(self) -> KeysIterator: ...
    def __next__(self) -> bytes: ...

class ValuesIterator(_Iter):
    def get(self) -> bytes: ...
    def next(self) -> bytes | None: ...
    def __iter__(self) -> ValuesIterator: ...
    def __next__(self) -> bytes: ...

class ItemsIterator(_Iter):
    def get(self) -> tuple[bytes, bytes]: ...
    def next(self) -> tuple[bytes, bytes] | None: ...
    def __iter__(self) -> ItemsIterator: ...
    def __next__(self) -> tuple[bytes, bytes]: ...

class _DB:
    def __init__(
        self, db_path: Any, opts: Any = ..., column_families: Any = ..., read_only: bool = ..., **kwargs: Any
    ) -> None: ...
    def put(
        self, key: bytes, value: bytes, sync: bool = ..., disable_wal: bool = ..., column_family: Any = ...
    ) -> None: ...
    def merge(
        self, key: bytes, value: bytes, sync: bool = ..., disable_wal: bool = ..., column_family: Any = ...
    ) -> None: ...
    def get(self, key: bytes, column_family: Any = ...) -> bytes | None: ...
    def delete(
        self, key: bytes, sync: bool = ..., disable_wal: bool = ..., column_family: Any = ...
    ) -> None: ...
    def delete_range(
        self,
        begin_key: bytes,
        end_key: bytes,
        sync: bool = ...,
        disable_wal: bool = ...,
        column_family: Any = ...,
    ) -> None: ...
    def write(self, batch: Any, sync: bool = ..., disable_wal: bool = ...) -> None: ...
    def multi_get(self, keys: list[bytes], column_family: Any = ...) -> dict[bytes, bytes | None]: ...
    def key_may_exist(
        self, key: bytes, fetch: bool = ..., column_family: Any = ...
    ) -> tuple[bool, bytes | None]: ...
    def iterkeys(self, *args: Any, **kwargs: Any) -> KeysIterator: ...
    def itervalues(self, *args: Any, **kwargs: Any) -> ValuesIterator: ...
    def iteritems(self, *args: Any, **kwargs: Any) -> ItemsIterator: ...
    def flush(self) -> None: ...
    def flush_wal(self, sync: bool = ...) -> None: ...
    def compact_range(
        self, begin: Any = ..., end: Any = ..., column_family: Any = ..., **kwargs: Any
    ) -> None: ...
    def refresh(self) -> bool: ...
    @property
    def version(self) -> int: ...
    def versions(self) -> list[tuple[int, int]]: ...
    def cleanup_old_versions(self, older_than: float) -> int: ...
    def purge(self, force: bool = ...) -> dict[str, Any]: ...
    def create_tag(self, tag: str, version: int | None = ...) -> None: ...
    def tags(self) -> list[tuple[str, int]]: ...
    def tag_version(self, tag: str) -> int: ...
    def delete_tag(self, tag: str) -> None: ...
    def stats(self) -> dict[str, int]: ...
    @property
    def uri(self) -> str: ...
    @property
    def read_only(self) -> bool: ...
    def close(self) -> None: ...

class Run:
    @property
    def id(self) -> str: ...
    @property
    def info(self) -> dict[str, Any]: ...
    def track(
        self,
        value: float,
        name: str,
        step: int | None = ...,
        epoch: int | None = ...,
        context: dict[str, Any] | None = ...,
        timestamp: int | None = ...,
    ) -> None: ...
    def track_many(
        self,
        name: str,
        values: Sequence[float],
        steps: Sequence[int | None] | None = ...,
        epochs: Sequence[int | None] | None = ...,
        context: dict[str, Any] | None = ...,
        timestamps: Sequence[int | None] | None = ...,
    ) -> None: ...
    def set_params(self, params: dict[str, Any]) -> None: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def update(
        self,
        name: str | None = ...,
        experiment: str | None = ...,
        description: str | None = ...,
        tags: list[str] | None = ...,
        archived: bool | None = ...,
        kind: str | None = ...,
        target: dict[str, Any] | None = ...,
    ) -> None: ...
    def finish(self, status: str = ..., ended_at: int | None = ...) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> bool: ...

class Repo:
    def __init__(
        self,
        uri: Any,
        storage_options: dict[str, str] | None = ...,
        create_if_missing: bool = ...,
        flush_rows: int = ...,
        flush_interval: float | None = ...,
        version_retention: float | None = ...,
        wal: bool = ...,
        wal_sync: str = ...,
        wal_dir: Any = ...,
        replay_stale_wal: bool = ...,
        legacy_records: str = ...,
    ) -> None: ...
    def cleanup_old_versions(self, older_than: float) -> int: ...
    def purge(self, force: bool = ...) -> dict[str, Any]: ...
    @property
    def uri(self) -> str: ...
    def create_run(
        self,
        name: str | None = ...,
        experiment: str | None = ...,
        description: str | None = ...,
        tags: list[str] | None = ...,
        run_id: str | None = ...,
        created_at: int | None = ...,
        kind: str | None = ...,
        target: dict[str, Any] | None = ...,
    ) -> Run: ...
    def resume_run(self, run_id: str) -> Run: ...
    def runs(self) -> list[dict[str, Any]]: ...
    def run(self, run_id: str) -> dict[str, Any] | None: ...
    def params(self, run_id: str) -> dict[str, Any]: ...
    def series(self, run_id: str) -> list[dict[str, Any]]: ...
    def all_params(self) -> dict[str, dict[str, Any]]: ...
    def all_series(self) -> list[dict[str, Any]]: ...
    def update_run(
        self,
        run_id: str,
        name: str | None = ...,
        experiment: str | None = ...,
        description: str | None = ...,
        tags: list[str] | None = ...,
        archived: bool | None = ...,
        status: str | None = ...,
        kind: str | None = ...,
        target: dict[str, Any] | None = ...,
    ) -> dict[str, Any]: ...
    def latest_versions(self) -> tuple[int, int, int, int]: ...
    def delete_runs(self, run_ids: list[str]) -> int: ...
    def series_stats(self, series_ids: list[int] | None = ...) -> dict[int, dict[str, Any]]: ...
    def recompute_series_stats(self, series_ids: list[int] | None = ...) -> int: ...
    def append_records(self, table: str, rows: list[dict[str, Any]]) -> int: ...
    def records(
        self,
        table: str,
        run_id: str | None = ...,
        item_id: str | None = ...,
        version: int | None = ...,
        tag: str | None = ...,
        run_ids: list[str] | None = ...,
    ) -> list[dict[str, Any]]: ...
    def legacy_records(self, table: str | None = ...) -> list[dict[str, Any]]: ...
    def has_legacy_records(self) -> bool: ...
    def drop_legacy_records(self) -> bool: ...
    def record_tables(self) -> list[str]: ...
    def records_version(self, table: str) -> int: ...
    def tag_records(self, table: str, tag: str, version: int | None = ...) -> None: ...
    def record_tags(self, table: str) -> list[tuple[str, int]]: ...
    def delete_record_tag(self, table: str, tag: str) -> None: ...
    def metric(
        self,
        run_id: str,
        name: str,
        context: dict[str, Any] | None = ...,
        start: int | None = ...,
        stop: int | None = ...,
        start_time: int | None = ...,
        stop_time: int | None = ...,
    ) -> dict[str, list[Any]]: ...
    def flush(self) -> None: ...
    def optimize(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> bool: ...
